<UserControl x:Class="AIEverything.App.PromotionScreenshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900" Height="560"
             FontFamily="{StaticResource AppFont}"
             Foreground="{StaticResource TextBrush}"
             Background="{StaticResource CanvasBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="4" Background="{StaticResource BrandBrush}">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="AIEverything" Margin="9,0,0,0" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Width="40" TextAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    <TextBlock Text="&#xE921;" Width="46" TextAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    <TextBlock Text="&#xE922;" Width="46" TextAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    <TextBlock Text="&#xE8BB;" Width="46" TextAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="20,16,20,13" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Border Height="44" Style="{StaticResource SearchFieldStyle}">
                    <Grid Margin="13,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="23" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SearchQueryText" Grid.Column="1" Text="华北区域目标"
                                   FontSize="15" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="3,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="5" Padding="13,6">
                                <TextBlock Text="全部" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="文件名" Margin="14,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="正文" Margin="6,0,12,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="文件名搜索全机；Word、TXT、Markdown 可搜正文"
                               Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="ResultsCard" Grid.Row="2" Margin="16,12" Style="{StaticResource CardStyle}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="ResultsHeader" Grid.Row="0" Background="{StaticResource SurfaceAltBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="13*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="15,0,0,0" Text="文件与路径" Style="{StaticResource EyebrowStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="14,0,12,0" Text="正文命中"
                               Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                    <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1"
                            Background="{StaticResource BorderBrush}" />
                </Grid>
                <StackPanel x:Name="ResultsItems" Grid.Row="1">
                    <Border Background="{StaticResource ResultSelectionBrush}"
                            BorderBrush="{StaticResource ResultSelectionBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Height="82">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="13*" />
                                <ColumnDefinition Width="7*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Background="{StaticResource BrandBrush}" CornerRadius="0,2,2,0" />
                            <Grid Grid.Column="1" Margin="12,10,14,10">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="季度销售计划.docx" FontSize="13" FontWeight="SemiBold" />
                                    <Border Grid.Column="1" Style="{StaticResource MetadataBadgeStyle}" Margin="8,0,0,0">
                                        <TextBlock Text="本地语义匹配" FontSize="10.5" Foreground="#245F8F" />
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MetadataBadgeStyle}">
                                        <TextBlock Text="销售计划 · 第 2 段" FontSize="10.5" Foreground="#245F8F" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="8,1,0,0"
                                               Text="D:\共享资料\销售部\季度销售计划.docx"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                </Grid>
                            </Grid>
                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,0,0,0" Padding="14,10,12,8">
                                <TextBlock Text="华北区域目标较上季度提升，重点推进核心客户续约。"
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5"
                                           LineHeight="17" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Height="68">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="13*" /><ColumnDefinition Width="7*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="15,10">
                                <TextBlock Text="区域目标明细.docx" FontSize="13" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Style="{StaticResource MetadataBadgeStyle}">
                                        <TextBlock Text="区域分解 · 表格 1 · 第 1 行 · 第 2 列" FontSize="10.5" Foreground="#245F8F" />
                                    </Border>
                                    <TextBlock Text="  2 处命中已合并" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="14,10">
                                <TextBlock Text="华北区域目标：1,250 万元" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Height="62">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="13*" /><ColumnDefinition Width="7*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="15,10">
                            <TextBlock Text="销售会议纪要.md" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="D:\共享资料\销售部\销售会议纪要.md"
                                       Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="14,10">
                            <TextBlock Text="华北区域目标将在八月底完成重点客户确认。"
                                       TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <TextBlock x:Name="StatusText" Text="找到 3 项 · 智能排序推荐" FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
