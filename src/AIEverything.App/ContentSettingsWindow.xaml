<Window x:Class="AIEverything.App.ContentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="ContentSettingsWindow"
        Title="本机搜索设置"
        Width="520" Height="650"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,17,20,14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="本机搜索设置" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="正文索引与桌面智能排序"
                           Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      AutomationProperties.AutomationId="SettingsScrollViewer"
                      Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,12">
            <TextBlock Text="正文索引" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="15,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前状态" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock x:Name="SettingsStatusText"
                                   AutomationProperties.AutomationId="SettingsStatusText"
                                   Text="正在读取…" Margin="0,5,0,0"
                                   FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsToggleButton"
                                AutomationProperties.AutomationId="SettingsToggleButton"
                                Content="启用正文" Style="{StaticResource SecondaryButtonStyle}"
                                Click="SettingsToggleButton_Click" />
                        <Button x:Name="SettingsSyncButton"
                                AutomationProperties.AutomationId="SettingsSyncButton"
                                Content="立即同步" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SettingsSyncButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="13,11" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="已索引" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock x:Name="SettingsIndexedText"
                                   AutomationProperties.AutomationId="SettingsIndexedText"
                                   Text="-" Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="13,11" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="队列" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock x:Name="SettingsQueueText"
                                   AutomationProperties.AutomationId="SettingsQueueText"
                                   Text="-" Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="13,11" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="失败" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock x:Name="SettingsFailureText"
                                   AutomationProperties.AutomationId="SettingsFailureText"
                                   Text="-" Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="未处理文件" FontWeight="SemiBold" />
                    <TextBlock x:Name="SettingsFailureGroupsText"
                               AutomationProperties.AutomationId="SettingsFailureGroupsText"
                               Text="损坏 0 · 加密/不支持 0 · 过大 0 · 超时 0 · 无权限 0"
                               Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SettingsRetryFailuresButton"
                                AutomationProperties.AutomationId="SettingsRetryFailuresButton"
                                Content="重试失败文件" Style="{StaticResource SecondaryButtonStyle}"
                                Click="SettingsRetryFailuresButton_Click" />
                        <Button x:Name="SettingsReportProblemButton"
                                AutomationProperties.AutomationId="SettingsReportProblemButton"
                                Content="反馈问题" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SettingsReportProblemButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="数据库" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="SettingsDatabasePathText" Grid.Column="1"
                               AutomationProperties.AutomationId="SettingsDatabasePathText"
                               Text="-" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Grid.Row="1" Text="占用空间" Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="SettingsDatabaseSizeText" Grid.Row="1" Grid.Column="1"
                               AutomationProperties.AutomationId="SettingsDatabaseSizeText"
                               Text="-" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <TextBlock x:Name="SettingsPrivacyNote"
                       AutomationProperties.AutomationId="SettingsPrivacyNote"
                       Text="正文索引只保存在本机 SQLite 数据库中，未单独加密且不会修改源文件；可选 DeepSeek 的片段外发需在下方另行授权。"
                       Margin="2,11,2,0" Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />

            <TextBlock Text="智能排序" FontSize="14" FontWeight="SemiBold" Margin="2,18,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="15,13">
                <StackPanel>
                    <CheckBox x:Name="BehaviorRankingToggle"
                              AutomationProperties.AutomationId="BehaviorRankingToggle"
                              Content="使用最近操作优化排序（默认开启）"
                              Checked="RankingSetting_Changed"
                              Unchecked="RankingSetting_Changed" />
                    <TextBlock Text="只在本机 ranking.db 保存随机盐加盐的文件键、父目录键、扩展名和每日权重聚合，保留 30 天。打开/复制计 1，定位计 0.5，预览后打开/复制再加 0.25，单独预览不计分；不保存查询、正文、片段或明文路径。清除会删除聚合并轮换随机盐。"
                               Margin="22,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <Button x:Name="ClearBehaviorButton"
                            AutomationProperties.AutomationId="ClearBehaviorButton"
                            Content="清除行为历史" HorizontalAlignment="Left"
                            Margin="22,10,0,0" Style="{StaticResource SecondaryButtonStyle}"
                            Click="ClearBehaviorButton_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="15,13" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox x:Name="LocalModelToggle"
                              AutomationProperties.AutomationId="LocalModelToggle"
                              Content="使用打包的本地模型重排前 10 项（默认开启）"
                              Checked="RankingSetting_Changed"
                              Unchecked="RankingSetting_Changed" />
                    <TextBlock x:Name="LocalModelStatusText"
                               AutomationProperties.AutomationId="LocalModelStatusText"
                               Text="等待后台预热。" Margin="22,6,0,0"
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="15,13" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock AutomationProperties.AutomationId="DeepSeekDisclosureText"
                               Text="DeepSeek 默认启用。仅在本地 ONNX 成功、无精确匹配且至少有 3 个普通候选，并出现分数接近、重名、名称/正文混合证据或自然语言歧义时才可能发送；明确文件名或路径查询绝不联网。发送当前查询、最多 10 个候选的文件名、完整路径和每项最多 200 字片段，由 DeepSeek 只选 Top5；不发送匹配来源、排序层级、文件本体或行为历史。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <CheckBox x:Name="DeepSeekToggle"
                              AutomationProperties.AutomationId="DeepSeekToggle"
                              Content="启用 DeepSeek 歧义重排（默认开启）"
                              Margin="0,10,0,0"
                              Checked="RankingSetting_Changed"
                              Unchecked="RankingSetting_Changed" />
                    <TextBlock x:Name="DeepSeekStatusText"
                               AutomationProperties.AutomationId="DeepSeekStatusText"
                               Text="已开启；未配置凭据时自动使用本地排序。" Margin="22,6,0,0"
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="总预算 1.5 秒，请求体不超过 24 KiB；单并发、滚动每分钟最多 10 次、会话缓存 10 分钟，限流或连续服务失败会熔断 30 秒且不重试。"
                               Margin="22,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="DeepSeek API 密钥（留空不更改）"
                               Margin="22,10,0,0" Foreground="{StaticResource MutedTextBrush}" />
                    <Grid Margin="22,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="DeepSeekApiKeyBox"
                                     AutomationProperties.AutomationId="DeepSeekApiKeyBox"
                                     MaxLength="2048" MinHeight="30" PasswordChar="●"
                                     VerticalContentAlignment="Center" />
                        <Button x:Name="SaveDeepSeekCredentialButton"
                                AutomationProperties.AutomationId="SaveDeepSeekCredentialButton"
                                Grid.Column="1" Content="保存 / 更新" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SaveDeepSeekCredentialButton_Click" />
                    </Grid>
                    <TextBlock Text="密钥仅保存到 Windows 凭据管理器 AIEverything/DeepSeek；设置文件、ranking.db 与日志均不保存密钥。发布版不读取环境变量，调试版才可回退 AIEVERYTHING_DEEPSEEK_API_KEY。"
                               Margin="22,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="SettingsFeedbackText"
                       AutomationProperties.AutomationId="SettingsFeedbackText"
                       Margin="2,7,2,0" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,11"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button x:Name="SettingsCloseButton"
                    AutomationProperties.AutomationId="SettingsCloseButton"
                    Content="关闭" HorizontalAlignment="Right" MinWidth="74"
                    Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"
                    Click="SettingsCloseButton_Click" />
        </Border>
    </Grid>
</Window>
