<Window x:Class="AIEverything.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AIEverything"
        Width="900" Height="560" MinWidth="820" MinHeight="520"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E5E5E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D2D2D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="ButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#C42B1C" />
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#A92418" />
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="TitleBar"
                AutomationProperties.AutomationId="TitleBar"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="4"
                            Background="{StaticResource BrandBrush}">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="AIEverything"
                               Margin="9,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="SettingsButton"
                            AutomationProperties.AutomationId="SettingsButton"
                            AutomationProperties.Name="设置"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="40" Height="36"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE713;" FontSize="15" ToolTip="设置"
                            Click="SettingsButton_Click" />
                    <Button x:Name="MinimizeButton"
                            AutomationProperties.AutomationId="MinimizeButton"
                            AutomationProperties.Name="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE921;" ToolTip="最小化"
                            Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeRestoreButton"
                            AutomationProperties.AutomationId="MaximizeRestoreButton"
                            AutomationProperties.Name="最大化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE922;" ToolTip="最大化"
                            Click="MaximizeRestoreButton_Click" />
                    <Button x:Name="CloseButton"
                            AutomationProperties.AutomationId="CloseButton"
                            AutomationProperties.Name="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Content="&#xE8BB;" ToolTip="关闭"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,16,20,13">
            <StackPanel>
                <Grid>
                    <Border Height="44" Style="{StaticResource SearchFieldStyle}">
                        <Grid Margin="13,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="23" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     AutomationProperties.AutomationId="SearchBox"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     ToolTip="输入文件名、路径或正文关键词"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AllMode" Content="全部" Tag="Hybrid"
                                         AutomationProperties.AutomationId="AllModeButton"
                                         IsChecked="True" GroupName="SearchMode"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         Checked="Mode_Checked" />
                            <RadioButton x:Name="NameMode" Content="文件名" Tag="FileName"
                                         AutomationProperties.AutomationId="NameModeButton"
                                         GroupName="SearchMode"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         Checked="Mode_Checked" />
                            <RadioButton x:Name="ContentMode" Content="正文" Tag="Content"
                                         AutomationProperties.AutomationId="ContentModeButton"
                                         GroupName="SearchMode"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         Checked="Mode_Checked" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Text="文件名搜索全机；TXT、Markdown 可搜正文" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <Border x:Name="BehaviorDisclosureBanner"
                    AutomationProperties.AutomationId="BehaviorDisclosureBanner"
                    Background="#FFF8E7" BorderBrush="#EBD9A5" BorderThickness="0,0,0,1"
                    Padding="20,10" Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                        <Button x:Name="BehaviorSettingsButton"
                                AutomationProperties.AutomationId="BehaviorSettingsButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="设置与清除" Click="BehaviorSettingsButton_Click" />
                        <Button x:Name="DisableBehaviorButton"
                                AutomationProperties.AutomationId="DisableBehaviorButton"
                                Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                Content="关闭学习" Click="DisableBehaviorButton_Click" />
                        <Button x:Name="AcknowledgeBehaviorButton"
                                AutomationProperties.AutomationId="AcknowledgeBehaviorButton"
                                Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                Content="知道了" Click="AcknowledgeBehaviorButton_Click" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="#5B4818" FontSize="11.5">
                        <Run FontWeight="SemiBold" Text="本地排序学习默认开启。" />
                        <Run Text=" 只记录成功操作的每日权重聚合：打开/复制计 1，定位计 0.5；单独预览不计分，预览后成功打开/复制再加 0.25。仅保存随机盐加盐的文件键、父目录键、扩展名，保留 30 天；不保存查询、正文、片段或明文路径，可关闭并随时清除。" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <Border x:Name="ContentDisclosureBanner"
                    Background="{StaticResource BrandSubtleBrush}"
                    BorderBrush="#C9E0F5" BorderThickness="0,0,0,1"
                    Padding="20,10" Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <Button x:Name="EnableContentButton"
                            AutomationProperties.AutomationId="EnableContentButton"
                            DockPanel.Dock="Right" Margin="16,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="启用正文" Click="EnableContentButton_Click" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="#244663" FontSize="11.5">
                        <Run FontWeight="SemiBold" Text="文件名搜索已可使用。" />
                        <Run Text=" 启用后将发现本机固定磁盘中的 TXT、MD、MARKDOWN；正文索引仅保存在本机未单独加密的 SQLite，不修改源文件。可选 DeepSeek 的片段外发需在设置中另行披露并主动开启。" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="3" Margin="16,12" Style="{StaticResource CardStyle}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="ResultsHeader" Grid.Row="0" Height="35"
                      Background="{StaticResource SurfaceAltBrush}"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="13*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="15,0,0,0"
                               Text="文件与路径" Style="{StaticResource EyebrowStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="14,0,12,0"
                               Text="正文命中" Style="{StaticResource EyebrowStyle}"
                               VerticalAlignment="Center" />
                    <Border VerticalAlignment="Bottom" Height="1"
                            Grid.ColumnSpan="2" Background="{StaticResource BorderBrush}" />
                </Grid>

                <DataGrid x:Name="ResultsGrid" Grid.Row="1"
                          AutomationProperties.AutomationId="ResultsGrid"
                          HeadersVisibility="None" AutoGenerateColumns="False"
                          MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                          PreviewMouseDown="ResultsGrid_UserInteraction"
                          PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown"
                          PreviewMouseWheel="ResultsGrid_UserInteraction"
                          PreviewKeyDown="ResultsGrid_UserInteraction"
                          SelectionChanged="ResultsGrid_SelectionChanged">
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="ResultsContextMenu" Opened="ResultsContextMenu_Opened">
                            <MenuItem x:Name="PreviewMenuItem"
                                      AutomationProperties.AutomationId="PreviewMenuItem"
                                      Header="预览"
                                      Click="PreviewButton_Click" />
                            <MenuItem x:Name="OpenMenuItem"
                                      AutomationProperties.AutomationId="OpenMenuItem"
                                      Header="打开"
                                      Click="OpenButton_Click" />
                            <MenuItem x:Name="LocateMenuItem"
                                      AutomationProperties.AutomationId="LocateMenuItem"
                                      Header="在资源管理器中定位"
                                      Click="LocateButton_Click" />
                            <Separator />
                            <MenuItem x:Name="CopyMenuItem"
                                      AutomationProperties.AutomationId="CopyMenuItem"
                                      Header="复制路径或引用"
                                      Click="CopyButton_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,-5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="13*" />
                                            <ColumnDefinition Width="7*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" x:Name="SelectionBar"
                                                Width="3" Margin="0,8,0,8"
                                                CornerRadius="0,2,2,0" Background="Transparent" />
                                        <Grid x:Name="FilePanel" Grid.Column="1" Margin="12,8,14,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />
                                                <Border x:Name="RankingReasonBadge" Grid.Column="1"
                                                        AutomationProperties.AutomationId="RankingReasonBadge"
                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Style="{StaticResource MetadataBadgeStyle}"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="{Binding RankingReason}" FontSize="10.5"
                                                               Foreground="#245F8F" />
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource MetadataBadgeStyle}">
                                                    <TextBlock Text="{Binding Location}" FontSize="10.5"
                                                               Foreground="#245F8F" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Margin="8,1,0,0"
                                                           Text="{Binding FullPath}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullPath}" />
                                            </Grid>
                                        </Grid>
                                        <Border x:Name="SnippetPanel" Grid.Column="2"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1,0,0,0" Padding="14,8,12,8">
                                            <TextBlock Text="{Binding Snippet}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11.5" LineHeight="17"
                                                       TextWrapping="Wrap" MaxHeight="34"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SnippetToolTip}" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsContentResult}" Value="False">
                                            <Setter TargetName="FilePanel" Property="Grid.ColumnSpan" Value="2" />
                                            <Setter TargetName="SnippetPanel" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasRankingReason}" Value="True">
                                            <Setter TargetName="RankingReasonBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                     Value="True">
                                            <Setter TargetName="SelectionBar" Property="Background"
                                                    Value="{StaticResource BrandBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyPanel" Grid.RowSpan="2"
                            MaxWidth="520" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="21"
                            Background="{StaticResource BrandSoftBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,13">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18" Foreground="{StaticResource BrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="输入关键词开始搜索"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyHint"
                               Text="查找文件名和路径，或定位 TXT、Markdown 中的具体段落"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,7,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ProgressBar x:Name="SearchProgress" Grid.Row="0" Grid.RowSpan="2"
                             Height="2" VerticalAlignment="Top"
                             IsIndeterminate="True" Visibility="Collapsed"
                             Foreground="{StaticResource BrandBrush}"
                             Background="Transparent" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="QueryStatusText"
                               AutomationProperties.AutomationId="QueryStatusText"
                               Text="找到 0 项"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
